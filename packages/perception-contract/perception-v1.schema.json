{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perception.intentsolutions.io/contracts/snapshot-v1.json",
  "title": "Perception Snapshot v1",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "staleAfter", "account", "topics", "signals", "brief", "sourceHealth"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "staleAfter": { "type": "string", "format": "date-time" },
    "account": { "type": "object", "required": ["id", "displayName"], "additionalProperties": false },
    "topics": { "type": "array", "maxItems": 8 },
    "signals": {
      "type": "array",
      "maxItems": 400,
      "items": {
        "type": "object",
        "required": ["id", "title", "url", "source", "lane", "relevance", "resolved", "quiet", "matchedTopicIds", "publishedAt", "read"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9_-]+$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 240 },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "source": { "type": "string", "minLength": 1, "maxLength": 80 },
          "lane": { "enum": ["incident", "release", "pricing", "engineering"] },
          "relevance": { "type": "number", "minimum": 0, "maximum": 100 },
          "resolved": { "type": "boolean" },
          "quiet": { "type": "boolean" },
          "matchedTopicIds": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
          "publishedAt": { "type": ["string", "null"], "format": "date-time" },
          "read": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "brief": { "type": "object" },
    "sourceHealth": { "type": "array" }
  },
  "additionalProperties": false
}
