  <entry>
    <id>tag:github.com,2008:Repository/590187800/v0.123.0</id>
    <updated>2026-08-19T13:31:54Z</updated>
    <link rel="alternate" type="text/html" href="https://github.com/anthropics/anthropic-sdk-python/releases/tag/v0.123.0"/>
    <title>v0.123.0</title>
    <content type="html">&lt;h2&gt;0.123.0 (2026-08-18)&lt;/h2&gt;
&lt;p&gt;Full Changelog: &lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/compare/v0.122.0...v0.123.0&quot;&gt;v0.122.0...v0.123.0&lt;/a&gt;&lt;/p&gt;
&lt;h3&gt;Features&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; additions to files and memory stores (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/09ce187e1c21029d636534fbabc7dd328f037c68&quot;&gt;09ce187&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; updates to skill, files, and user profiles (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/c6cbffdb6df46d96d873c613d0ca5baff6745768&quot;&gt;c6cbffd&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;client:&lt;/strong&gt; add helpers for accessing the workspace ID in response headers (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/f79882b74628469d7aa8a003995fd01ec0836369&quot;&gt;f79882b&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Bug Fixes&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;api:&lt;/strong&gt; remove unsupported mid_conv_system content block (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/6f15b8d6018247b48d826b814c1a2e6bd6af71e8&quot;&gt;6f15b8d&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;client:&lt;/strong&gt; compute platform headers without spawning a subprocess (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/baca9f443c0a596ba5926e2c2c205ed03047af8a&quot;&gt;baca9f4&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;client:&lt;/strong&gt; export custom status errors from _exceptions.&lt;strong&gt;all&lt;/strong&gt; (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/issues/459&quot; data-hovercard-type=&quot;issue&quot; data-hovercard-url=&quot;/anthropics/anthropic-sdk-python/issues/459/hovercard&quot;&gt;#459&lt;/a&gt;) (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/2950ec46cb18f01f705267a7dcb8775ed5469359&quot;&gt;2950ec4&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;client:&lt;/strong&gt; export ServiceUnavailableError and DeadlineExceededError from the package root (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/issues/468&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/anthropics/anthropic-sdk-python/pull/468/hovercard&quot;&gt;#468&lt;/a&gt;) (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/0dcd06d1a1da60021aa926f66bd066be9cf6509b&quot;&gt;0dcd06d&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;session-runner:&lt;/strong&gt; retry tool-result sends for at least the lease TTL (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/issues/453&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/anthropics/anthropic-sdk-python/pull/453/hovercard&quot;&gt;#453&lt;/a&gt;) (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/e1a48917193ed914e9af466143a0b0c962a5b892&quot;&gt;e1a4891&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;tools:&lt;/strong&gt; run synchronous session tools in a worker thread (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/issues/399&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/anthropics/anthropic-sdk-python/pull/399/hovercard&quot;&gt;#399&lt;/a&gt;) (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/8f88c57d70cc3813392be9195c9d29fe022d49d0&quot;&gt;8f88c57&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Chores&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;examples:&lt;/strong&gt; remove legacy Text Completions API examples (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/cf5c76870efccea1069e219a0bc52170c068f804&quot;&gt;cf5c768&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;internal:&lt;/strong&gt; remove leftover prism references (&lt;a href=&quot;https://github.com/anthropics/anthropic-sdk-python/commit/826ba7a3ea06636421fecb5f6394a50df3ca85d5&quot;&gt;826ba7a&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;</content>
